public class Ejercicio17 : MonoBehaviour
{
    List<Enemy> enemigos = new List<Enemy>();
    [System.Serializable] public class Enemy
{
        public int vida;
        public Enemy(int v)
        {
            vida = v;
        }
}
    void Start()
    {
        AgregarEnemigo(100);
        AgregarEnemigo(80);
        AgregarEnemigo(120);
        for (int i = 0; i < enemigos.Count; i++)
        {
            Debug.Log("Enemigo " + i + " vida: " + enemigos[i].vida);
        }
    }
    void Update()
    {
    }
    public void AgregarEnemigo(int vida)
    {
        enemigos.Add(new Enemy(vida));
    }
}
